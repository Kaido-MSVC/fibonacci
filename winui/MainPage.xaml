<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FibonacciWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="zh-TW">

    <Grid MaxWidth="960" Padding="24,12,24,24" RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="費波那契數列" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="AboutButton"
                Click="AboutButton_Click"
                Content="關於" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
            <TextBox
                x:Name="IndexInput"
                AutomationProperties.AutomationId="IndexInput"
                Header="項次 N（0–1,000,000）"
                InputScope="Number"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                KeyDown="IndexInput_KeyDown"
                Loaded="IndexInput_Loaded"
                MaxLength="21"
                Text="100" />
            <Button
                x:Name="CalculateButton"
                Grid.Column="1"
                MinWidth="92"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="CalculateButton"
                Click="CalculateButton_Click"
                Content="計算"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <InfoBar
            x:Name="Feedback"
            Grid.Row="2"
            Margin="0,0,0,12"
            AutomationProperties.AutomationId="Feedback"
            IsOpen="False" />

        <Border
            Grid.Row="3"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="ResultHeading"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="計算結果" />
                        <TextBlock
                            x:Name="ResultDetails"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="輸入項次後按 Enter 或「計算」。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="CopyButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="CopyButton"
                        AutomationProperties.Name="複製結果"
                        Click="CopyButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Copy" />
                            <TextBlock Text="複製結果" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressBar
                    x:Name="CalculationProgress"
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    IsIndeterminate="False"
                    Visibility="Collapsed" />

                <TextBox
                    x:Name="ResultOutput"
                    Grid.Row="2"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="ResultOutput"
                    AutomationProperties.Name="費波那契數字"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="16"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />

                <Grid
                    x:Name="PageControls"
                    Grid.Row="3"
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="8"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="PageLabel"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="PreviousPageButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="PreviousPageButton"
                        Click="PreviousPageButton_Click"
                        Content="上一頁" />
                    <Button
                        x:Name="NextPageButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="NextPageButton"
                        Click="NextPageButton_Click"
                        Content="下一頁" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
